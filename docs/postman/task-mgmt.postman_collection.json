              }
            }
          ]
        },
        {
          "name": "PATCH rename label",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Defect\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/labels/{{createdLabelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "labels", "{{createdLabelId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('renamed', () => pm.expect(pm.response.json().name).to.eql('Defect'));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE created label",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/labels/{{createdLabelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "labels", "{{createdLabelId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok:true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Logout + revocation",
      "item": [
        {
          "name": "POST /auth/logout (revokes current refresh)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok:true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh after logout → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Confirms the token we just revoked can no longer buy a new access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
