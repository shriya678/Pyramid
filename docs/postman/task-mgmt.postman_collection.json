{
  "info": {
    "name": "Task Management System — Local API",
    "description": "End-to-end tests for the local backend. Run requests top-to-bottom; earlier requests capture tokens into collection variables that later requests consume. Base URL and tokens are collection variables — no separate environment needed.\n\nBefore running: docker compose up -d && pnpm dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "oldRefreshToken", "value": "", "type": "string" },
    { "key": "workspaceSlug", "value": "", "type": "string" },
    { "key": "createdStatusId", "value": "", "type": "string" },
    { "key": "defaultStatusId", "value": "", "type": "string" },
    { "key": "createdLabelId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('db is up', () => pm.expect(pm.response.json().db).to.eql('up'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "POST /auth/guest (creates guest + captures tokens)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/guest",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "guest"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns tokens + user + workspace', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.refreshToken).to.be.a('string');",
                  "  pm.expect(body.user.isGuest).to.eql(true);",
                  "  pm.expect(body.workspace.slug).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('workspaceSlug', body.workspace.slug);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me WITHOUT Bearer → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me (Bearer required)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is guest', () => pm.expect(body.isGuest).to.eql(true));",
                  "pm.test('primaryWorkspace matches captured slug', () => {",
                  "  pm.expect(body.primaryWorkspace.slug).to.eql(pm.collectionVariables.get('workspaceSlug'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh (rotate)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns fresh access + refresh', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "  pm.expect(body.refreshToken).to.be.a('string');",
                  "});",
                  "// Save the OLD refresh so the next test can prove reuse is rejected.",
                  "pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken'));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refresh with OLD token → 401 (reuse rejected)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{oldRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('says invalid or expired', () => {",
                  "  pm.expect(pm.response.json().message).to.match(/invalid|expired/i);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/google (verify 302 to Google)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            },
            "description": "Postman follows redirects by default. To verify the initial 302, disable 'Automatically follow redirects' in Postman Settings before running. Otherwise you'll see the final Google page (which will error since Postman isn't a browser)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This test assumes 'Automatically follow redirects' is DISABLED in Postman settings.",
                  "// If enabled, you'll get a different status from Google's actual page.",
                  "pm.test('302 redirect (if follow redirects is OFF) OR reaches Google', () => {",
                  "  pm.expect([200, 302, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Workspaces",
      "item": [
        {
          "name": "GET /workspaces (list mine)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns 1 workspace', () => pm.expect(body).to.have.lengthOf(1));",
                  "pm.test('user is OWNER', () => pm.expect(body[0].role).to.eql('OWNER'));",
                  "pm.test('slug matches captured', () => {",
                  "  pm.expect(body[0].slug).to.eql(pm.collectionVariables.get('workspaceSlug'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /workspaces/:slug (detail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has expected shape', () => {",
                  "  pm.expect(body).to.include.keys('id', 'slug', 'name', 'role', 'createdAt', 'updatedAt');",
                  "  pm.expect(body.role).to.eql('OWNER');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /workspaces/does-not-exist → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspaces/does-not-exist-nope-nope",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "does-not-exist-nope-nope"]
            },
            "description": "Verifies the WorkspaceMemberGuard hides workspaces the user can't see. 404 (not 403) is intentional so we don't leak existence."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('generic error message (no info leak)', () => {",
                  "  pm.expect(pm.response.json().message).to.match(/not found/i);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /workspaces/:slug (rename — OWNER can)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed via Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('name updated', () => pm.expect(body.name).to.eql('Renamed via Postman'));",
                  "pm.test('updatedAt >= createdAt', () => {",
                  "  pm.expect(new Date(body.updatedAt).getTime()).to.be.at.least(new Date(body.createdAt).getTime());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /workspaces/:slug with empty name → 400 (validation)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}"]
            },
            "description": "Proves class-validator's @MinLength(1) is running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "PATCH /workspaces/:slug with extra field → 400 (mass assignment)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sneaky\",\n  \"slug\": \"hijacked\",\n  \"ownerId\": \"someone-else\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}"]
            },
            "description": "Proves forbidNonWhitelisted:true on the global ValidationPipe — attackers can't inject fields the DTO doesn't declare."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('rejects the extra property', () => {",
                  "  const message = JSON.stringify(pm.response.json());",
                  "  pm.expect(message).to.match(/should not exist|property.*slug|property.*ownerId/i);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Statuses",
      "item": [
        {
          "name": "GET /workspaces/:slug/statuses (list) + capture first id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/statuses",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "statuses"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('workspace has the 4 default statuses', () => pm.expect(list).to.have.lengthOf(4));",
                  "pm.test('returned in ascending order', () => {",
                  "  const orders = list.map(s => s.order);",
                  "  const sorted = [...orders].sort((a,b) => a-b);",
                  "  pm.expect(orders).to.eql(sorted);",
                  "});",
                  "// Capture the id of the first (leftmost) status; later delete test will use it as moveTo.",
                  "pm.collectionVariables.set('defaultStatusId', list[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create 'Blocked' status",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blocked\",\n  \"color\": \"#ef4444\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/statuses",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "statuses"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has expected fields', () => {",
                  "  pm.expect(body.name).to.eql('Blocked');",
                  "  pm.expect(body.color).to.eql('#ef4444');",
                  "  pm.expect(body.order).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('createdStatusId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST duplicate name → 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blocked\",\n  \"color\": \"#ff0000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/statuses",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "statuses"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "POST invalid color → 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Purple\",\n  \"color\": \"purple\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/statuses",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "statuses"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('mentions hex format', () => pm.expect(JSON.stringify(pm.response.json())).to.match(/hex|color/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH rename + recolor",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Waiting\",\n  \"color\": \"#f59e0b\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/statuses/{{createdStatusId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "statuses", "{{createdStatusId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('renamed + recolored', () => {",
                  "  pm.expect(b.name).to.eql('Waiting');",
                  "  pm.expect(b.color).to.eql('#f59e0b');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE created status (no tasks attached)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceSlug}}/statuses/{{createdStatusId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceSlug}}", "statuses", "{{createdStatusId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('nothing to move', () => pm.expect(pm.response.json().movedTasks).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Labels",
      "item": [
