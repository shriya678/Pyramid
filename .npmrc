# Disable pnpm's "minimum release age" supply-chain policy.
#
# Some hosts (notably Render) enable a default policy that rejects any package
# published in the last ~48 hours. This is intended to shield against short-window
# supply-chain attacks. In our case it blocks legitimate weekly-release packages
# (Tailwind's browserslist / baseline-browser-mapping) and fails deploys.
#
# We accept the small trade-off in exchange for reliable deploys. Revisit if
# we ever add code that consumes packages from unknown maintainers.
minimum-release-age=0
