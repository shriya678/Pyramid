# Dependencies
node_modules/
.pnpm-store/

# Stray per-package lockfiles.
# pnpm workspaces must have a SINGLE root pnpm-lock.yaml. If `pnpm --filter <app>
# add <pkg>` ever writes a per-app one (a known pnpm quirk that surfaces when the
# CLI momentarily loses the workspace root), ignore it here so it can't get
# committed and out-of-sync with the authoritative root lockfile.
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Testing / coverage
coverage/
.nyc_output/

# Prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Cloudinary / uploads (local caching if any)
uploads/tmp/

# Sentry
.sentryclirc

# Turbo / Nx cache (if added later)
.turbo/
.nx/

# Misc
*.tgz

Figma/

# Internal working plan (not distributed in the repo)
docs/PLAN.md

docs/REQUIREMENTS.md

docs/DEPLOY.md

interview-prep/